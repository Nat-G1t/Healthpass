# HealthPass — settings for the Bluetooth BP bridge (healthpass-bp.service, D-59).
# Copy to /etc/healthpass/bp-daemon.env — readable by root only, it holds the key:
#   sudo install -D -m 600 scripts/pi/bp-daemon.env.example /etc/healthpass/bp-daemon.env
# then fill in the values. See docs/deployment-pi.md §4a.

# Bluetooth address of the clinic's A&D UA-651BLE.
BP_ADDRESS=B0:B1:13:3B:C5:94

# Where readings go — the same server the kiosk page is loaded from.
#   Pi-local fallback (§10):  http://127.0.0.1/api/kiosk/bp-reading
#   Hosted deploy (D-34):     https://<domain>/api/kiosk/bp-reading
BP_POST_URL=http://127.0.0.1/api/kiosk/bp-reading

# The SAME value as HEALTHPASS_KIOSK_KEY in that server's .env. Never commit it.
HEALTHPASS_KIOSK_KEY=
